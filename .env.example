# ===== Gmail設定 =====
# Googleアカウントでアプリパスワードを作成する必要があります
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# 通知先メールアドレス
NOTIFY_EMAIL=your-email@gmail.com

# ===== sFLR (Sceptre) 設定 =====
# sFLR監視を有効にするか（true/false）
SFLR_ENABLED=true
# DEXが安いと判定するしきい値（公式 - DEX >= この値）
SFLR_DISCOUNT_THRESHOLD=0.025

# ===== stFLR (SparkDEX) 設定 =====
# stFLR監視を有効にするか（true/false）
STFLR_ENABLED=true
# DEXが安いと判定するしきい値（公式 - DEX >= この値）
STFLR_DISCOUNT_THRESHOLD=0.0008
# DEXが高いと判定するしきい値（公式 - DEX < この値）
STFLR_PREMIUM_THRESHOLD=-0.0002

# ===== 共通設定 =====
# 監視間隔（ミリ秒）- デフォルト: 60000 (1分)
CHECK_INTERVAL=60000
