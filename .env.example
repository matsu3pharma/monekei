# Gmail設定
# Googleアカウントでアプリパスワードを作成する必要があります
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# 通知先メールアドレス
NOTIFY_EMAIL=your-email@gmail.com

# ===== sFLR (Sceptre) 設定 =====
# sFLR監視を有効にするか（true/false）
SFLR_ENABLED=true

# ===== stFLR (SparkDEX) 設定 =====
# stFLR監視を有効にするか（true/false）
STFLR_ENABLED=true

# ===== アラート設定 =====
# 価格差アラートしきい値（FLR単位）- 差額がこれ以上で通知
PRICE_DIFF_THRESHOLD=0.15

# DEX有利アラート（sFLR用）- DEX価格 >= 公式レート - マージン のとき通知
DEX_ADVANTAGE_ALERT=true
DEX_ADVANTAGE_MARGIN=0.0005

# DEX割安アラート（stFLR用）- DEX価格 <= 公式レート - マージン のとき通知
DEX_DISCOUNT_ALERT=true
DEX_DISCOUNT_MARGIN=0.0005

# 監視間隔（ミリ秒）- デフォルト: 60000 (1分)
CHECK_INTERVAL=60000
