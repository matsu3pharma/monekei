# Gmail設定
# Googleアカウントでアプリパスワードを作成する必要があります
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# 通知先メールアドレス
NOTIFY_EMAIL=your-email@gmail.com

# 価格差アラートしきい値（FLR単位）
PRICE_DIFF_THRESHOLD=0.15

# DEX有利アラート（true で有効）
# DEX価格 >= Sceptre価格 - マージン のとき通知
DEX_ADVANTAGE_ALERT=true

# DEX有利判定のマージン（FLR単位）
DEX_ADVANTAGE_MARGIN=0.0005

# 監視間隔（ミリ秒）- デフォルト: 60000 (1分)
CHECK_INTERVAL=60000
